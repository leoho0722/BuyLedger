# backend 容器執行期變數範本。複製為 deploy/backend.env 後填入實值。
#   cp deploy/backend.env.example deploy/backend.env
DATABASE_URL=
# 允許的前端來源 (CORS；例：http://localhost:3000)。
WEB_ORIGIN=
# 外部 API key
EXCHANGE_RATE_API_KEY=
OLLAMA_API_KEY=
# Firebase service account：把金鑰 JSON 放進 apps/backend/ (已 gitignore)，由 compose volume 掛到下列路徑。
# 缺則後端 fail-closed、拒絕啟動 (auth 不可降級)。或改用 FIREBASE_PROJECT_ID/CLIENT_EMAIL/PRIVATE_KEY 三變數。
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=
# Dev-only：設 true 才啟用 /api/dev/token (簽發 custom token 供自動登入、繞過互動式 OAuth)。
# 等同無條件簽發任意 uid 身分，production 絕不可設 true (預設關閉)。
DEV_AUTH_ENABLED=false
