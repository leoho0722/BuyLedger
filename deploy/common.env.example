# BuyLedger Web compose 內插用環境變數範本 (對外發佈埠)。複製為 deploy/common.env 後填入實值。
#   cp deploy/common.env.example deploy/common.env   (或 `make env` 一次建立全部)
# 由 Makefile 以 --env-file deploy/common.env 載入；web build args 見 deploy/web.env.example；容器執行期變數見 db.env.example / backend.env.example。

# 對外發佈埠 (容器內部固定 5432 / 4000 / 3000；建議同值)。
DB_PORT=
BACKEND_PORT=
WEB_PORT=
