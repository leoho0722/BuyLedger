# BuyLedger Web compose 內插用環境變數範本 (ports 與 build arg)。複製為 deploy/common.env 後填入實值。
#   cp deploy/common.env.example deploy/common.env   (或 `make env` 一次建立全部)
# 由 Makefile 以 --env-file deploy/common.env 載入；容器執行期變數見 deploy/db.env.example 與 deploy/backend.env.example。

# 對外發佈埠 (容器內部固定 5432 / 4000 / 3000；建議同值)。
DB_PORT=
BACKEND_PORT=
WEB_PORT=

# 前端打後端的 base URL；build 期 inline 進 client bundle，須為瀏覽器端可達位址 (例：http://localhost:4000/api)。
NEXT_PUBLIC_API_BASE_URL=
