{
  "$comment": "欄位級合併 (field-level merge) conformance vectors。backend/web/iOS 的合併實作須對同一組向量全綠。clock 採 p(13):c(6):w 編碼。expectedChanged 省略時不檢查。",
  "cases": [
    {
      "name": "disjoint fields both survive (auto-merge)",
      "storedValues": { "customerName": "王", "amount": "100" },
      "storedClocks": { "customerName": "1700000000000:000000:device-a", "amount": "1700000000000:000000:device-a" },
      "patch": { "changedFields": { "amount": "200" }, "fieldClocks": { "amount": "1700000000005:000000:device-b" } },
      "expectedValues": { "customerName": "王", "amount": "200" },
      "expectedAppliedClocks": { "amount": "1700000000005:000000:device-b" },
      "expectedChanged": true
    },
    {
      "name": "same field higher clock wins",
      "storedValues": { "amount": "100" },
      "storedClocks": { "amount": "1700000000000:000000:device-a" },
      "patch": { "changedFields": { "amount": "200" }, "fieldClocks": { "amount": "1700000000005:000000:device-b" } },
      "expectedValues": { "amount": "200" },
      "expectedAppliedClocks": { "amount": "1700000000005:000000:device-b" },
      "expectedChanged": true
    },
    {
      "name": "same field equal clock keeps stored",
      "storedValues": { "amount": "100" },
      "storedClocks": { "amount": "1700000000003:000000:device-a" },
      "patch": { "changedFields": { "amount": "200" }, "fieldClocks": { "amount": "1700000000003:000000:device-a" } },
      "expectedValues": { "amount": "100" },
      "expectedAppliedClocks": { "amount": "1700000000003:000000:device-a" },
      "expectedChanged": false
    },
    {
      "name": "same field lower clock loses, applied clock is the stored authority",
      "storedValues": { "amount": "100" },
      "storedClocks": { "amount": "1700000000005:000000:device-a" },
      "patch": { "changedFields": { "amount": "200" }, "fieldClocks": { "amount": "1700000000000:000000:device-b" } },
      "expectedValues": { "amount": "100" },
      "expectedAppliedClocks": { "amount": "1700000000005:000000:device-a" },
      "expectedChanged": false
    },
    {
      "name": "new entity accepts all incoming fields",
      "storedValues": {},
      "storedClocks": {},
      "patch": { "changedFields": { "customerName": "新", "amount": "50" }, "fieldClocks": { "customerName": "1700000000000:000000:device-b", "amount": "1700000000000:000000:device-b" } },
      "expectedValues": { "customerName": "新", "amount": "50" },
      "expectedAppliedClocks": { "customerName": "1700000000000:000000:device-b", "amount": "1700000000000:000000:device-b" },
      "expectedChanged": true
    },
    {
      "name": "idempotent resend is a no-op",
      "storedValues": { "amount": "200" },
      "storedClocks": { "amount": "1700000000005:000000:device-b" },
      "patch": { "changedFields": { "amount": "200" }, "fieldClocks": { "amount": "1700000000005:000000:device-b" } },
      "expectedValues": { "amount": "200" },
      "expectedAppliedClocks": { "amount": "1700000000005:000000:device-b" },
      "expectedChanged": false
    },
    {
      "name": "items array is whole-field LWW (v1)",
      "storedValues": { "items": [{ "id": "i1", "quantity": 1 }] },
      "storedClocks": { "items": "1700000000000:000000:device-a" },
      "patch": { "changedFields": { "items": [{ "id": "i1", "quantity": 5 }, { "id": "i2", "quantity": 2 }] }, "fieldClocks": { "items": "1700000000005:000000:device-b" } },
      "expectedValues": { "items": [{ "id": "i1", "quantity": 5 }, { "id": "i2", "quantity": 2 }] },
      "expectedAppliedClocks": { "items": "1700000000005:000000:device-b" },
      "expectedChanged": true
    }
  ]
}
