  "cards": [
    {
      "dot": "cyan",
      "title": "入口與實作功能分離",
      "items": [
        "More 只負責選擇導覽目的地；FX、Customers、Quote、LookupManagement 與 Settings 的邏輯各自留在子功能。"
      ]
    },
    {
      "dot": "emerald",
      "title": "主檔目錄有獨立生命週期",
      "items": [
        "LookupCatalog 不依附堆疊畫面，負責主檔載入及訂單表單的新增選項請求。"
      ]
    },
    {
      "dot": "amber",
      "title": "跨功能結果向上轉送",
      "items": [
        "客戶選取、主檔改名、付款方式更正與偏好變更皆由 More 轉送 Root；進入設定前會清空舊堆疊。"
      ]
    }
  ]
