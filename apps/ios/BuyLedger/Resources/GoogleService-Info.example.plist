<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  GoogleService-Info.example.plist

  將此檔複製成 `GoogleService-Info.plist` (已加入 .gitignore)，從 Firebase Console
  下載實際專案的設定檔覆蓋

  本檔僅供讓乾淨 clone 在沒有真實 Firebase 專案的情況下也能通過 CI：值一律為明顯的
  佔位字串，不含任何真實識別碼，App 啟動時 FirebaseApp.configure() 會用它完成初始化，
  但不會有任何遙測資料實際送達 (因為 Firebase 專案不存在)。CI 於建置前複製此檔為正式
  檔名；本檔已列入建置設定的成員例外清單，不會被打包進 App bundle
-->
<dict>
	<key>API_KEY</key>
	<string>A00000000000000000000000000000000000000</string>
	<key>BUNDLE_ID</key>
	<string>com.example.BuyLedgerPlaceholder</string>
	<key>CLIENT_ID</key>
	<string>000000000000-placeholderclientid.apps.googleusercontent.com</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<false/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>PROJECT_ID</key>
	<string>buyledger-placeholder</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.000000000000-placeholderclientid</string>
	<key>STORAGE_BUCKET</key>
	<string>buyledger-placeholder.firebasestorage.app</string>
</dict>
</plist>
