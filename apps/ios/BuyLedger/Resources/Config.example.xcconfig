//
//  Config.example.xcconfig
//  BuyLedger
//
//  將此檔複製成 `Config.xcconfig`（已加入 .gitignore），填入個人 API key 後在
//  Xcode → Project → Info → Configurations 把 Debug 與 Release 的 Configuration
//  指向 `Config.xcconfig`。
//
//  Info.plist 已經以 `$(EXCHANGE_RATE_API_KEY)` 引用此變數，App 啟動時透過
//  `AppConfiguration.liveValue` 從 `Bundle.main.infoDictionary` 讀回。
//

// 申請於 https://www.exchangerate-api.com/ — 30 日 sparkline 需要 Pro/Business 方案
EXCHANGE_RATE_API_KEY =

// 申請於 https://ollama.com/ (Account → API keys) — AI 商品明細總結走 Ollama Cloud chat streaming
OLLAMA_API_KEY =
