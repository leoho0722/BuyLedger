{
  "sourceLanguage" : "zh-Hant",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access is required to add group-order reminders to your calendar and remove their corresponding events when you delete them."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要行事曆權限，才能將開團的訂購提醒加入你的行事曆，並在你移除時刪除對應事件。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to authenticate you so the app can unlock and continue after you enable App Lock."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用 Face ID 驗證身份，才能在你啟用 App 鎖定後解鎖並繼續使用。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
