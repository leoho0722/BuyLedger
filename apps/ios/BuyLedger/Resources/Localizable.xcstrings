    },
    "orders.lookup.message.paymentMethodGuide" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The “No Card” tag shows cardless discount and top-up fields in order edit; the “Bank Transfer” tag shows reconciliation status; the “Cash on Delivery” tag includes estimated shipping in collection, deducting all three shipping costs from profit. To edit names or categories, select “Edit” on the row."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「無卡」標籤代表此付款方式會在訂單編輯顯示「無卡折抵金額」與「無卡補款金額」欄位；「銀行匯款」標籤代表會顯示「對帳狀態」欄位；「貨到付款」標籤代表收款金額已含預估運費，獲利會自動扣除三種運費。需要修改名稱或分類時，對該列選「編輯」即可。"
          }
        }
      }
    },
    "orders.lookup.message.useAddCategory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Add Category above to create the first category. You can also add one while editing an order."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過上方「新增類別」加入第一個類別；訂單編輯時也能新增。"
          }
        }
      }
    },
    "orders.lookup.message.useAddPayment" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Add Payment Method above to create the first item. You can also add one while editing an order."
