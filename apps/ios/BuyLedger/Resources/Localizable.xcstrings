    "common.ui.message.whenEnabled" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, orders using this payment method treat the received amount as including estimated shipping, so domestic, international, and foreign domestic shipping are deducted from profit."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，使用此付款方式的訂單因收款金額已含預估運費，獲利會自動扣除國內、國際與外國國內三種運費。"
          }
        }
      }
    },
    "common.ui.message.whenEnabledOrders" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, orders using this payment method show Cardless Deduction and Cardless Supplemental Payment fields in Received Amount, and include them in the total received formula."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，使用此付款方式的訂單在「收款金額」區段會出現「無卡折抵金額」與「無卡補款金額」兩個欄位，並計入總收款公式。"
          }
        }
      }
    },
    "common.ui.message.whenEnabledOrdersUsing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, orders using this payment method show a Reconciliation Status field so you can mark the result after funds arrive."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，使用此付款方式的訂單在編輯時會出現「對帳狀態」欄位，供你在款項入帳後標記對帳結果。"
          }
        }
      }
    },
