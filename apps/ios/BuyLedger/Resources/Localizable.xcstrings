    "orders.lookup.message.confirmRecalculateNotice" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After confirmation, %lld existing orders will be recalculated for payment flags and profit. Deduction, supplement, or reconciliation status may be cleared. This cannot be undone."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認後將重算 %lld 筆既有訂單的付款旗標與獲利；折抵、補款或對帳狀態可能被清除。此操作無法復原。"
          }
        }
      }
    },
    "orders.lookup.message.deleteUndoneNotice" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
