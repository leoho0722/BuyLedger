    "ai.summary.message.aiSummaryReached" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI summary reached its time limit. The content received so far is shown; the summary was cut short."
