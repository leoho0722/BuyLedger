        "version": "1.0.6",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-dependencies",
      "version": {
        "version": "1.12.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-case-paths",
      "version": {
        "version": "1.7.3",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-perception",
      "version": {
        "version": "2.0.10",
      },
    }, {
      "kind": "remote",
