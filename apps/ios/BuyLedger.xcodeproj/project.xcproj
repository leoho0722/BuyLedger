        "version": "1.19.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/firebase/firebase-ios-sdk",
      "version": {
        "version": "12.13.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/gonzalezreal/textual",
      "version": {
        "version": "0.1.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-sharing",
      "version": {
        "version": "2.9.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-identified-collections",
      "version": {
        "version": "1.1.1",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "BuyLedger",
      "target-membership": [
        "BuyLedger",
      ],
      "membership-exceptions": [
        {
          "target": "BuyLedger",
          "exclusions": [
            "Resources/Config.example.xcconfig",
            "Resources/Config.xcconfig",
            "Resources/GoogleService-Info.example.plist",
            "Resources/Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "BuyLedgerTests", "target-membership": [ "BuyLedgerTests" ] },
    { "kind": "folder", "path": "BuyLedgerUITests", "target-membership": [ "BuyLedgerUITests" ] },
    { "kind": "folder", "path": "BuyLedgerAccessibilityIDs", "target-membership": [ "BuyLedger", "BuyLedgerUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/BuyLedger.app", "id": "D0B1FCCD2FA22A9F00B50E07", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/BuyLedgerTests.xctest", "id": "D0B1FCDE2FA22AA100B50E07", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/BuyLedgerUITests.xctest", "id": "D0B1FCE82FA22AA100B50E07", "type": "wrapper.cfbundle", "index": false },
      ],
    }, {
      "kind": "group",
      "name": "Recovered References",
      "children": [
        { "path": "<PROJECT>/BuyLedger/Resources/Config.xcconfig" },
      ],
    },
    { "kind": "group", "name": "Frameworks" },
  ],
  "targets": [
    {
      "name": "BuyLedger",
      "id": "D0B1FCCC2FA22A9F00B50E07",
      "product": "Products/BuyLedger.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Recovered References/Config.xcconfig" },
        { "name": "Release", "file": "Recovered References/Config.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Run Script: Crashlytics Symbol Upload",
          "log-environment-variables": true,
          "input-paths": [
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${PRODUCT_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${PRODUCT_NAME}.debug.dylib",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Info.plist",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist",
            "$(TARGET_BUILD_DIR)/$(EXECUTABLE_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"${BUILD_DIR%/Build/*}/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/run\"\n",
        },
      ],
      "package-product-members": [
        {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAnalytics",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCrashlytics",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebasePerformance",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-case-paths",
          "product-name": "CasePaths",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-composable-architecture",
          "product-name": "ComposableArchitecture",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-dependencies",
          "product-name": "Dependencies",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-identified-collections",
          "product-name": "IdentifiedCollections",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-navigation",
          "product-name": "SwiftNavigation",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-navigation",
          "product-name": "SwiftNavigation",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-perception",
          "product-name": "Perception",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-perception",
          "product-name": "PerceptionCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-sharing",
          "product-name": "Sharing",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "textual",
          "product-name": "Textual",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "408",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT": "dwarf-with-dsym",
        "DEVELOPMENT_TEAM": "23JEQ2524P",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "BuyLedger/Resources/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription": "需要行事曆權限，才能將開團的訂購提醒加入你的行事曆，並在你移除時刪除對應事件。",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "需要使用 Face ID 驗證身份，才能在你啟用 App 鎖定後解鎖並繼續使用。",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "2.1.0",
        "OTHER_LDFLAGS": "-ObjC",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.leoho.BuyLedger",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "XROS_DEPLOYMENT_TARGET": "26.4",
      },
