// BuyLedger 後端持久化 schema。資料形狀對齊 shared/data-model 生成型別。
// 金額/比率一律 NUMERIC (decimal.js)，不可用浮點；日期用 timestamptz。
// 跨裝置同步 metadata (fieldClocks / deletedAt / deleteClock / mirror* / recordClock)
// 僅存於後端持久化層，刻意不進 shared/data-model schema (延續 ownerUid 先例)。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 訂單。customer 攤平為三欄、items 以 JSON 內嵌、photos 以 base64 字串陣列存。
model Order {
  id                       String    @id
  ownerUid                 String
  customerName             String
  customerInitials         String
  customerTier             String // CustomerTier raw value: new/regular/vip
  status                   String // OrderStatus raw value
  currency                 String // ISO 4217
  date                     DateTime  @db.Timestamptz(3)
  items                    Json // LedgerOrderItem[]：{ id, name, quantity, unitPrice(string) }
  itemCost                 Decimal   @db.Decimal(28, 10)
  domesticShipping         Decimal   @db.Decimal(28, 10)
  internationalShipping    Decimal   @db.Decimal(28, 10)
  foreignDomesticShipping  Decimal   @db.Decimal(28, 10)
  cardFeeRate              Decimal   @db.Decimal(18, 10)
  platformFeeRate          Decimal   @db.Decimal(18, 10)
  paymentFeeRate           Decimal   @db.Decimal(18, 10)
  chargedAmount            Decimal   @db.Decimal(28, 10)
  cardlessDeductionAmount  Decimal   @db.Decimal(28, 10)
  cardlessSupplementAmount Decimal   @db.Decimal(28, 10)
  orderSource              String
  categories               String[]
  paymentMethod            String
  notes                    String
  verificationStatus       String
  campaignNames            String[]
  paymentReceiptStatus     String // PaymentReceiptStatus raw value: pending/received
  isCashOnDelivery         Boolean
  photos                   String[] // base64 (已正規化 JPEG)
  mergedSourceIDs          String[]
  // 跨裝置同步 metadata (僅後端持久化、不進 shared/data-model schema)。
  fieldClocks              Json      @default("{}") // { 欄位名: HLC 字串 }
  deletedAt                DateTime? @db.Timestamptz(3)
  deleteClock              String    @default("")
  mirrorDirty              Boolean   @default(false)
  mirrorPendingSinceClock  String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([ownerUid])
  @@index([ownerUid, deletedAt])
  @@index([date])
  @@index([status])
}

// 開團。狀態僅 ongoing/closed；結團以 settledDate 紀錄、不改 status。
model Campaign {
  id                      String    @id
  ownerUid                String
  name                    String
  openDate                DateTime  @db.Timestamptz(3)
  closeDate               DateTime? @db.Timestamptz(3)
  status                  String // CampaignStatus raw value
  settledDate             DateTime? @db.Timestamptz(3)
  notes                   String    @default("")
  // 跨裝置同步 metadata (僅後端持久化、不進 shared/data-model schema)。
  fieldClocks             Json      @default("{}")
  deletedAt               DateTime? @db.Timestamptz(3)
  deleteClock             String    @default("")
  mirrorDirty             Boolean   @default(false)
  mirrorPendingSinceClock String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([ownerUid])
  @@index([ownerUid, deletedAt])
}

// 商品類別主檔 (name 即識別值)。recordClock 為整筆 LWW 同步並行控制。
model Category {
  ownerUid    String
  name        String
  recordClock String   @default("")
  createdAt   DateTime @default(now())

  @@id([ownerUid, name])
}

// 訂單來源主檔。
model OrderSource {
  ownerUid    String
  name        String
  recordClock String   @default("")
  createdAt   DateTime @default(now())

  @@id([ownerUid, name])
}

// 對帳狀態主檔 (verificationStatus)。
model VerificationStatus {
  ownerUid    String
  name        String
  recordClock String   @default("")
  createdAt   DateTime @default(now())

  @@id([ownerUid, name])
}

// 付款方式主檔，帶三個獨立旗標。
model PaymentMethod {
  ownerUid         String
  name             String
  isCardless       Boolean  @default(false)
  isBankTransfer   Boolean  @default(false)
  isCashOnDelivery Boolean  @default(false)
  recordClock      String   @default("")
  createdAt        DateTime @default(now())

  @@id([ownerUid, name])
}

// 幣別清單快取 (單例)；7 天 TTL 由 service 依 updatedAt 判定。
model CurrencyMetadata {
  id        String    @id @default("singleton")
  codes     String[]
  updatedAt DateTime?
}

// 最新匯率快照 (單例)；rates 為 { 目標幣別: decimal 字串 }。
model FxSnapshot {
  id    String   @id @default("latest")
  base  String
  date  DateTime @db.Timestamptz(3)
  rates Json
}

// App 設定 (單例)，對齊 iOS Settings。recordClock 為整筆 LWW 同步並行控制。
model Settings {
  ownerUid          String  @id
  appearance        String  @default("system")
  notifications     Boolean @default(true)
  useAiSummary      Boolean @default(false)
  aiSummaryModel    String  @default("gemma4:31b-cloud")
  defaultCurrency   String  @default("TWD")
  monthlyProfitGoal Decimal @default(80000) @db.Decimal(28, 10)
  recordClock       String  @default("")
}
